# Copy this file to the ignored repository-root `.env` for local development.
# Populate private values only in `.env`; never commit it. Process/deployment
# environment values take precedence over `.env` for CI, containers, and production.

# Required backend secrets (replace both placeholders locally):
NEXETL_DJANGO_SECRET_KEY=replace-with-a-local-secret
NEXETL_DB_PASSWORD=replace-with-a-local-password
NEXETL_CONNECTION_SECRET_KEY=replace-with-private-connection-secret-key-material

# Pipeline runtime safety and worker settings
NEXETL_BATCH_SIZE=1000
NEXETL_PREVIEW_DEFAULT_ROWS=50
NEXETL_PREVIEW_MAX_ROWS=200
NEXETL_WORKER_CONCURRENCY=2
NEXETL_WORKER_POLL_SECONDS=2
NEXETL_WORKER_LEASE_SECONDS=120
NEXETL_STATEFUL_MAX_ROWS=100000

# PostgreSQL local-development settings
NEXETL_DB_NAME=nexetl
NEXETL_DB_USER=nexetl
NEXETL_DB_HOST=127.0.0.1
NEXETL_DB_PORT=5432

# Backend local HTTP settings
NEXETL_DJANGO_DEBUG=false
NEXETL_ALLOWED_HOSTS=localhost,127.0.0.1
# Local HTTP development requires these explicit overrides. Production must use true.
NEXETL_SESSION_COOKIE_SECURE=false
NEXETL_CSRF_COOKIE_SECURE=false
# Required for the local SvelteKit origin to send CSRF-protected browser requests.
NEXETL_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# DEVELOPMENT ONLY — never enable in production, staging, or public deployment.
NEXETL_DEV_SUPERADMIN_ENABLED=false
# Optional when explicitly enabled locally: username defaults to admin; password defaults to 123.
# NEXETL_DEV_SUPERADMIN_USERNAME=admin
# NEXETL_DEV_SUPERADMIN_PASSWORD=123

# Frontend browser-safe and local-development settings
PUBLIC_NEXETL_API_BASE_PATH=/api
NEXETL_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
