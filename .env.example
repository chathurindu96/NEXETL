# Copy this file to the ignored repository-root `.env` for local development.
# Populate private values only in `.env`; never commit it. Process/deployment
# environment values take precedence over `.env` for CI, containers, and production.

# Required backend secrets (replace both placeholders locally):
NEXETL_DJANGO_SECRET_KEY=replace-with-a-local-secret
NEXETL_DB_PASSWORD=replace-with-a-local-password

# PostgreSQL local-development settings
NEXETL_DB_NAME=nexetl
NEXETL_DB_USER=nexetl
NEXETL_DB_HOST=127.0.0.1
NEXETL_DB_PORT=5432

# Backend local HTTP settings
NEXETL_DJANGO_DEBUG=false
NEXETL_ALLOWED_HOSTS=localhost,127.0.0.1
NEXETL_SESSION_COOKIE_SECURE=true
NEXETL_CSRF_COOKIE_SECURE=true

# Frontend browser-safe and local-development settings
PUBLIC_NEXETL_API_BASE_PATH=/api
NEXETL_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
