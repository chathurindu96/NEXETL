# This is an environment-variable reference only. NEXETL does not load .env files.
# Supply real secret values through the process or deployment environment; never commit them.

# Required backend secrets (set these externally; no sample values are provided):
# NEXETL_DJANGO_SECRET_KEY
# NEXETL_DB_PASSWORD

# PostgreSQL local-development settings
NEXETL_DB_NAME=nexetl
NEXETL_DB_USER=nexetl
NEXETL_DB_HOST=127.0.0.1
NEXETL_DB_PORT=5432

# Backend local HTTP settings
NEXETL_DJANGO_DEBUG=false
NEXETL_ALLOWED_HOSTS=localhost,127.0.0.1
NEXETL_SESSION_COOKIE_SECURE=true
NEXETL_CSRF_COOKIE_SECURE=true

# Frontend browser-safe and local-development settings
PUBLIC_NEXETL_API_BASE_PATH=/api
NEXETL_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
